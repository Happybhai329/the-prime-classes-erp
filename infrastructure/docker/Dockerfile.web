# ============================================================
# Prime ERP Web — Production Dockerfile
# Multi-stage build: Node.js build → Nginx serve
# ============================================================

# Stage 1: Build
FROM node:20.15.0-alpine3.20 AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared-types/package.json ./packages/shared-types/

RUN pnpm install --frozen-lockfile

COPY packages/shared-types/ ./packages/shared-types/
COPY apps/web/ ./apps/web/

RUN pnpm --filter @prime/shared-types build
RUN pnpm --filter @prime/web build

# Stage 2: Serve
FROM nginx:1.25.4-alpine AS production

LABEL maintainer="The Prime Classes <admin@theprimeclasses.com>" \
      version="1.0.0" \
      description="Production Dockerfile for Prime Classes ERP Web"

# Copy dedicated Nginx config for static web files
COPY infrastructure/nginx/nginx-web.conf /etc/nginx/nginx.conf

# Copy build artifacts with correct ownership
COPY --from=builder --chown=nginx:nginx /app/apps/web/dist /usr/share/nginx/html

# Support running Nginx as non-root user (nginx has UID 101 in Alpine)
RUN touch /tmp/nginx.pid && \
    chown -R nginx:nginx /tmp/nginx.pid /var/cache/nginx /var/log/nginx /etc/nginx

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["nginx", "-g", "daemon off;"]

