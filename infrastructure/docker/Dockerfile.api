# ============================================================
# Prime ERP API — Production Dockerfile
# Multi-stage build for minimal image size
# ============================================================

# Stage 1: Build
FROM node:20.15.0-alpine3.20 AS builder
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# Copy workspace files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/mobile/package.json ./apps/mobile/
COPY packages/shared-types/package.json ./packages/shared-types/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source
COPY packages/shared-types/ ./packages/shared-types/
COPY apps/api/ ./apps/api/

# Build shared types
RUN pnpm --filter @prime/shared-types build

# Generate Prisma client
RUN pnpm --filter @prime/api exec prisma generate

# Build API
RUN pnpm --filter @prime/api build

# Stage 2: Production
FROM node:20.15.0-alpine3.20 AS production
WORKDIR /app/apps/api

# Install dumb-init and clear cache
RUN apk add --no-cache dumb-init

# Build metadata labels
LABEL maintainer="The Prime Classes <admin@theprimeclasses.com>" \
      version="1.0.0" \
      description="Production Dockerfile for Prime Classes ERP API"

# Copy built output with node user ownership
COPY --from=builder --chown=node:node /app/node_modules /app/node_modules
COPY --from=builder --chown=node:node /app/packages/shared-types /app/packages/shared-types
COPY --from=builder --chown=node:node /app/apps/api /app/apps/api

# Create logs directory and ensure node user has full permissions on /app
RUN mkdir -p /app/apps/api/logs && chown -R node:node /app

# Set environment
ENV NODE_ENV=production
EXPOSE 3000

# Use non-root node user
USER node

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/v1/health/ready || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/main.js"]

