{
  "name": "prime-erp",
  "version": "0.1.0",
  "private": true,
  "description": "The Prime Classes — ERP + Student Management + Parent Portal",
  "author": "The Prime Classes",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "db:migrate": "pnpm --filter @prime/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @prime/api exec prisma db seed",
    "db:studio": "pnpm --filter @prime/api exec prisma studio",
    "db:generate": "pnpm --filter @prime/api exec prisma generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
