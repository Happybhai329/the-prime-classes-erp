# ============================================================
# Prime ERP — API Staging Environment Configuration
# ============================================================

# ---- Application ----
NODE_ENV=staging
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=https://staging.primeclasses.in,https://staging-admin.primeclasses.in

# ---- Database ----
DATABASE_URL=postgresql://prime_staging_user:staging_password_here@staging-db.primeclasses.internal:5432/prime_staging?schema=public

# ---- Redis ----
REDIS_HOST=staging-redis.primeclasses.internal
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_password_here

# ---- JWT ----
JWT_ACCESS_SECRET=staging-access-secret-change-this-regularly-2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=staging-refresh-secret-change-this-regularly-2026
JWT_REFRESH_EXPIRY=7d

# ---- MinIO / S3 Storage ----
MINIO_ENDPOINT=staging-s3.primeclasses.internal
MINIO_PORT=9000
MINIO_ACCESS_KEY=staging_minio_key
MINIO_SECRET_KEY=staging_minio_secret_here
MINIO_BUCKET=prime-staging-files
MINIO_USE_SSL=true

# ---- Firebase ----
FIREBASE_PROJECT_ID=prime-staging-fcm
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@prime-staging-fcm.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSTAGING_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---- Razorpay (Staging/Test Keys) ----
RAZORPAY_KEY_ID=rzp_test_staging123
RAZORPAY_KEY_SECRET=staging_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=staging_webhook_secret_here

# ---- Email (SMTP) ----
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@staging.primeclasses.in
SMTP_PASSWORD=staging_smtp_password_here
SMTP_FROM=noreply@staging.primeclasses.in

# ---- Rate Limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- Observability & OpenTelemetry ----
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo.monitoring.svc.cluster.local:4318/v1/traces
GRAFANA_ADMIN_PASSWORD=staging-grafana-pass
ENABLE_ENTERPRISE_SCHEDULES=true
