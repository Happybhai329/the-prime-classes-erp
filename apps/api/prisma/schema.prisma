model ApiClient {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String?         @map("organization_id") @db.Uuid
  tenantId       String?         @map("tenant_id") @db.Uuid
  name           String          @db.VarChar(160)
  description    String?         @db.Text
  status         ApiClientStatus @default(ACTIVE)
  scopes         String[]        @default([])
  rateLimitPerMinute Int         @default(120) @map("rate_limit_per_minute")
  createdBy      String?         @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator        User?           @relation("ApiClientCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  keys           ApiKey[]
  usageLogs      ApiUsageLog[]
  webhookEndpoints WebhookEndpoint[]

  @@index([organizationId])
  @@index([tenantId])
  @@map("api_clients")
}

model ApiKey {
  id             String       @id @default(uuid()) @db.Uuid
  clientId       String       @map("client_id") @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  tenantId       String?      @map("tenant_id") @db.Uuid
  keyPrefix      String       @map("key_prefix") @db.VarChar(24)
  keyHash        String       @map("key_hash") @db.VarChar(255)
  status         ApiKeyStatus @default(ACTIVE)
  scopes         String[]     @default([])
  lastUsedAt     DateTime?    @map("last_used_at")
  expiresAt      DateTime?    @map("expires_at")
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")

  client         ApiClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator        User?        @relation("ApiKeyCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([keyPrefix])
  @@index([clientId])
  @@index([tenantId])
  @@map("api_keys")
}

model ApiUsageLog {
  id             String   @id @default(uuid()) @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  method         String   @db.VarChar(12)
  path           String   @db.VarChar(500)
  statusCode     Int      @map("status_code")
  durationMs     Int      @map("duration_ms")
  ipAddress      String?  @map("ip_address") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  client         ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([tenantId, createdAt])
  @@map("api_usage_logs")
}

model WebhookEndpoint {
  id             String   @id @default(uuid()) @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  url            String   @db.VarChar(500)
  secretHash     String   @map("secret_hash") @db.VarChar(255)
  secretEncrypted String  @map("secret_encrypted") @db.Text
  eventTypes     String[] @default([]) @map("event_types")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  client         ApiClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@index([tenantId])
  @@index([organizationId])
  @@map("webhook_endpoints")
}

model WebhookEvent {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String?            @map("organization_id") @db.Uuid
  tenantId       String?            @map("tenant_id") @db.Uuid
  eventType      String             @map("event_type") @db.VarChar(120)
  payload        Json
  status         WebhookEventStatus @default(PENDING)
  idempotencyKey String?            @unique @map("idempotency_key") @db.VarChar(255)
  createdAt      DateTime           @default(now()) @map("created_at")

  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tenant         Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  deliveries     WebhookDelivery[]

  @@index([tenantId, createdAt])
  @@index([eventType])
  @@map("webhook_events")
}

model WebhookDelivery {
  id             String                  @id @default(uuid()) @db.Uuid
  eventId        String                  @map("event_id") @db.Uuid
  endpointId     String                  @map("endpoint_id") @db.Uuid
  status         PublicWebhookDeliveryStatus @default(PENDING)
  attemptCount   Int                     @default(0) @map("attempt_count")
  nextAttemptAt  DateTime?               @map("next_attempt_at")
  responseCode   Int?                    @map("response_code")
  responseBody   String?                 @map("response_body") @db.Text
  lastError      String?                 @map("last_error") @db.Text
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  event          WebhookEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint       WebhookEndpoint         @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([eventId, endpointId])
  @@index([status])
  @@index([nextAttemptAt])
  @@map("webhook_deliveries")
}

model MarketplaceApp {
  id             String               @id @default(uuid()) @db.Uuid
  name           String               @db.VarChar(160)
  slug           String               @unique @db.VarChar(120)
  publisher      String               @db.VarChar(160)
  description    String?              @db.Text
  status         MarketplaceAppStatus @default(DRAFT)
  scopes         String[]             @default([])
  manifest       Json                 @default("{}")
  submittedBy    String?              @map("submitted_by") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  submitter      User?                @relation("MarketplaceAppSubmittedBy", fields: [submittedBy], references: [id], onDelete: SetNull)
  installations  MarketplaceInstallation[]
  extensionPoints ExtensionPoint[]
  themePackages  ThemePackage[]
  pluginEvents   PluginEvent[]

  @@index([status])
  @@map("marketplace_apps")
}

model MarketplaceInstallation {
  id             String                        @id @default(uuid()) @db.Uuid
  appId          String                        @map("app_id") @db.Uuid
  organizationId String?                       @map("organization_id") @db.Uuid
  tenantId       String?                       @map("tenant_id") @db.Uuid
  scope          MarketplaceScope              @default(TENANT)
  status         MarketplaceInstallationStatus @default(ACTIVE)
  config         Json                          @default("{}")
  installedBy    String?                       @map("installed_by") @db.Uuid
  installedAt    DateTime                      @default(now()) @map("installed_at")

  app            MarketplaceApp                @relation(fields: [appId], references: [id], onDelete: Cascade)
  organization   Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant?                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installer      User?                         @relation("MarketplaceInstallationInstalledBy", fields: [installedBy], references: [id], onDelete: SetNull)
  permissionGrants MarketplacePermissionGrant[]

  @@index([appId])
  @@index([organizationId])
  @@index([tenantId])
  @@map("marketplace_installations")
}

model MarketplacePermissionGrant {
  id             String   @id @default(uuid()) @db.Uuid
  installationId String   @map("installation_id") @db.Uuid
  permission     String   @db.VarChar(120)
  grantedAt      DateTime @default(now()) @map("granted_at")

  installation   MarketplaceInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, permission])
  @@map("marketplace_permission_grants")
}

model IntegrationSecret {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  name           String   @db.VarChar(160)
  secretRef      String   @map("secret_ref") @db.VarChar(255)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tenantId])
  @@map("integration_secrets")
}

model ExtensionPoint {
  id        String             @id @default(uuid()) @db.Uuid
  appId     String             @map("app_id") @db.Uuid
  type      ExtensionPointType
  name      String             @db.VarChar(160)
  config    Json               @default("{}")
  createdAt DateTime           @default(now()) @map("created_at")

