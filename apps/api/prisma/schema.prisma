  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  payment        FeePayment  @relation(fields: [paymentId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@map("fee_receipts")
}

// ============================================================
// STUDY MATERIALS
