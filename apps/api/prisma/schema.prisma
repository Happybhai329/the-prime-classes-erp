  @@index([subjectId])
  @@index([difficulty])
  @@index([deletedAt])
  @@map("questions")
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ
  NUMERICAL
  TRUE_FALSE
  SUBJECTIVE
}

model QuestionBank {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  name        String         @db.VarChar(255)
  description String?        @db.Text
  subjectId   String         @map("subject_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questionBankQuestions QuestionBankQuestion[]

  @@index([tenantId])
  @@map("question_banks")
}

model QuestionBankQuestion {
  questionBankId String @map("question_bank_id") @db.Uuid
  questionId     String @map("question_id") @db.Uuid

  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([questionBankId, questionId])
  @@map("question_bank_questions")
}

model OnlineTest {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  batchId         String         @map("batch_id") @db.Uuid
  subjectId       String?        @map("subject_id") @db.Uuid
  title           String         @db.VarChar(255)
  description     String?        @db.Text
  testMode        OnlineTestMode @map("test_mode")
  durationMinutes Int            @map("duration_minutes")
  totalMarks      Decimal        @map("total_marks") @db.Decimal(6, 2)
  passingMarks    Decimal        @map("passing_marks") @db.Decimal(6, 2)
  negativeMarking Decimal        @default(0) @map("negative_marking") @db.Decimal(5, 2)
  scheduledStart  DateTime       @map("scheduled_start") @db.Timestamp
  scheduledEnd    DateTime       @map("scheduled_end") @db.Timestamp
  isPublished     Boolean        @default(false) @map("is_published")
  sectionalSettings Json?        @map("sectional_settings")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  // Relations
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  batch           Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject         Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions       OnlineTestQuestion[]
  attempts        TestAttempt[]

  @@index([tenantId])
  @@index([batchId])
  @@index([deletedAt])
  @@map("online_tests")
}

enum OnlineTestMode {
  PRACTICE
  MOCK
  SCHOLARSHIP
  ENTRANCE_SIMULATION
}

model OnlineTestQuestion {
  onlineTestId String @map("online_test_id") @db.Uuid
  questionId   String @map("question_id") @db.Uuid
  sortOrder    Int    @map("sort_order")
  marks        Decimal @db.Decimal(5, 2)

  onlineTest   OnlineTest @relation(fields: [onlineTestId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([onlineTestId, questionId])
  @@map("online_test_questions")
}

model TestAttempt {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  onlineTestId    String         @map("online_test_id") @db.Uuid
  studentId       String         @map("student_id") @db.Uuid
  startedAt       DateTime       @default(now()) @map("started_at")
  submittedAt     DateTime?      @map("submitted_at")
  status          AttemptStatus  @default(IN_PROGRESS)
  scoreObtained   Decimal?       @map("score_obtained") @db.Decimal(6, 2)
  accuracy        Decimal?       @db.Decimal(5, 2)
  timeSpentSeconds Int?          @map("time_spent_seconds")
  resumeState     Json?          @map("resume_state")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  onlineTest      OnlineTest     @relation(fields: [onlineTestId], references: [id], onDelete: Cascade)
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  responses       TestResponse[]

  @@unique([onlineTestId, studentId])
  @@index([tenantId])
  @@index([studentId])
  @@map("test_attempts")
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  AUTO_SUBMITTED
  ABANDONED
}

model TestResponse {
  id            String      @id @default(uuid()) @db.Uuid
  testAttemptId String      @map("test_attempt_id") @db.Uuid
  questionId    String      @map("question_id") @db.Uuid
  selectedAnswer String?    @map("selected_answer") @db.Text
  isCorrect     Boolean?    @map("is_correct")
  marksObtained Decimal?    @map("marks_obtained") @db.Decimal(5, 2)
  timeSpentSeconds Int?     @map("time_spent_seconds")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  attempt       TestAttempt @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)

  @@unique([testAttemptId, questionId])
  @@map("test_responses")
}

model StudentAchievement {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  studentId       String          @map("student_id") @db.Uuid
  achievementType AchievementType @map("achievement_type")
  points          Int             @default(0)
  badgeName       String?         @map("badge_name") @db.VarChar(100)
  badgeImageUrl   String?         @map("badge_image_url") @db.VarChar(500)
  description     String?         @db.Text
  earnedAt        DateTime        @default(now()) @map("earned_at")

  // Relations
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@map("student_achievements")
}

enum AchievementType {
  BADGE
  POINTS
  LEVEL_UP
}

model VideoLecture {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  batchId       String?     @map("batch_id") @db.Uuid
  subjectId     String?     @map("subject_id") @db.Uuid
  title         String      @db.VarChar(255)
  description   String?     @db.Text
  videoUrl      String      @map("video_url") @db.VarChar(500)
  provider      VideoProvider @default(MINIO)
  durationSeconds Int?      @map("duration_seconds")
  thumbnailUrl  String?     @map("thumbnail_url") @db.VarChar(500)
  isLive        Boolean     @default(false) @map("is_live")
  scheduledStart DateTime?  @map("scheduled_start")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  batch         Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  subject       Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("video_lectures")
}

enum VideoProvider {
  MINIO
  YOUTUBE
  VIMEO
  AWS_MEDIACONVERT
  M3U8
}

