}

model ThemePackage {
  id        String   @id @default(uuid()) @db.Uuid
  appId     String?  @map("app_id") @db.Uuid
  name      String   @db.VarChar(160)
  version   String   @db.VarChar(40)
  manifest  Json     @default("{}")
