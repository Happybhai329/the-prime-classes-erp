  targetExam     String?             @map("target_exam") @db.VarChar(80)
  payload        Json                @default("{}")
  version        Int                 @default(1)
  isPublished    Boolean             @default(false) @map("is_published")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publications   ResourcePublication[]

  @@index([organizationId])
  @@index([assetType])
  @@map("shared_academic_assets")
}

model ResourcePublication {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  organizationUnitId String?           @map("organization_unit_id") @db.Uuid
  branchId           String?           @map("branch_id") @db.Uuid
  tenantId           String?           @map("tenant_id") @db.Uuid
  resourceItemId      String?          @map("resource_item_id") @db.Uuid
  sharedAssetId       String?          @map("shared_asset_id") @db.Uuid
