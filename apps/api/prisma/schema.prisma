// ============================================================
// Prime ERP — Prisma Schema
// Production-grade, multi-tenant, SaaS-ready
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANT
// ============================================================

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  plan      TenantPlan @default(FREE)
  settings  Json     @default("{}")
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users              User[]
  students           Student[]
  parents            Parent[]
  faculty            Faculty[]
  batches            Batch[]
  subjects           Subject[]
  attendanceSessions AttendanceSession[]
  tests              Test[]
  feeStructures      FeeStructure[]
  feeInvoices        FeeInvoice[]
  feePayments        FeePayment[]
  studyMaterials     StudyMaterial[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  // Phase 3
  notices            Notice[]
  supportTickets     SupportTicket[]
  documents          Document[]
  // Phase 4
  studentFees        StudentFee[]
  feeDiscounts       FeeDiscount[]
  feeRefunds         FeeRefund[]
  feeReceipts        FeeReceipt[]

  // Phase 5
  materials          Material[]
  materialCategories MaterialCategory[]
  materialAccessLogs MaterialAccessLog[]
  assignments        Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  questions          Question[]
  questionBanks      QuestionBank[]
  onlineTests        OnlineTest[]
  testAttempts       TestAttempt[]
  studentAchievements StudentAchievement[]
  videoLectures      VideoLecture[]

  @@map("tenants")
}

enum TenantPlan {
  FREE
  PRO
  ENTERPRISE
}

// ============================================================
// USER & AUTHENTICATION
// ============================================================

model User {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  email            String    @db.VarChar(255)
  phone            String?   @db.VarChar(20)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  role             UserRole
  isActive         Boolean   @default(true) @map("is_active")
  lastLogin        DateTime? @map("last_login")
  refreshTokenHash String?   @map("refresh_token_hash") @db.VarChar(500)
  fcmToken         String?   @map("fcm_token") @db.VarChar(500)
  passwordResetToken String? @map("password_reset_token") @db.VarChar(500)
  passwordResetExpiry DateTime? @map("password_reset_expiry")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  student          Student?
  parent           Parent?
  faculty          Faculty?

  // Reverse relations
  attendancesTaken AttendanceSession[] @relation("AttendanceTakenBy")
  testsCreated     Test[]              @relation("TestCreatedBy")
  marksEntered     TestMarks[]         @relation("MarksEnteredBy")
  materialsUploaded StudyMaterial[]    @relation("MaterialUploadedBy")
  paymentsCollected FeePayment[]      @relation("PaymentCollectedBy")
  notificationsCreated Notification[] @relation("NotificationCreatedBy")
  notificationLogs NotificationLog[]
  auditLogs        AuditLog[]
  // Phase 3
  noticesCreated   Notice[]           @relation("NoticeCreatedBy")
  noticeReadLogs   NoticeReadLog[]    @relation("NoticeReadBy")
  ticketsCreated   SupportTicket[]    @relation("TicketCreatedBy")
  ticketsAssigned  SupportTicket[]    @relation("TicketAssignedTo")
  ticketMessages   TicketMessage[]    @relation("TicketMessageSender")
  documentsUploaded Document[]        @relation("DocumentUploadedBy")

  // Phase 5
  newMaterialsUploaded Material[]      @relation("NewMaterialUploadedBy")
  newVersionsUploaded  MaterialVersion[] @relation("NewVersionUploadedBy")
  materialAccessLogs MaterialAccessLog[] @relation("MaterialAccessByUser")
  assignmentsCreated Assignment[]      @relation("AssignmentCreatedBy")
  submissionsReviewed AssignmentSubmission[] @relation("AssignmentSubmissionReviewedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FACULTY
  STUDENT
  PARENT
  ACCOUNTANT
}

// ============================================================
// STUDENT
// ============================================================

model Student {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @unique @map("user_id") @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  rollNumber      String        @map("roll_number") @db.VarChar(50)
  firstName       String        @map("first_name") @db.VarChar(100)
  lastName        String        @map("last_name") @db.VarChar(100)
  dob             DateTime      @db.Date
  gender          Gender
  aadharNumber    String?       @map("aadhar_number") @db.VarChar(255) // encrypted
  schoolName      String        @map("school_name") @db.VarChar(255)
  classStudying   String        @map("class_studying") @db.VarChar(50)
  address         Json          @default("{}")
  admissionDate   DateTime      @map("admission_date") @db.Date
  status          StudentStatus @default(ACTIVE)
  targetExam      TargetExam[]  @map("target_exam")
  photoUrl        String?       @map("photo_url") @db.VarChar(500)
  documents       Json          @default("{}") // { aadhar: url, birth_cert: url, ... }
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  // Relations
  user            User          @relation(fields: [userId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  parentMappings  StudentParentMap[]
  batchEnrollments BatchStudent[]
  attendanceRecords AttendanceRecord[]
  testMarks       TestMarks[]
  testRankings    TestRanking[]
  feeInvoices     FeeInvoice[]
  // Phase 4
  studentFees     StudentFee[]
  // Phase 3
  uploadedDocuments Document[]

  // Phase 5
  points             Int               @default(0)
  level              Int               @default(1)
  materialFavorites  MaterialFavorite[]
  assignmentSubmissions AssignmentSubmission[]
  testAttempts       TestAttempt[]
  achievements       StudentAchievement[]
  analyticsSnapshot  StudentAnalyticsSnapshot?

  @@unique([tenantId, rollNumber])
  @@index([tenantId])
  @@index([status])
  @@index([deletedAt])
  @@map("students")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  PASSED_OUT
  DROPPED
}

enum TargetExam {
  SAINIK
  RMS
  RIMC
  SCHOLARSHIP
  NAVODAYA
  FOUNDATION
}

// ============================================================
// PARENT
// ============================================================

model Parent {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  fatherName       String   @map("father_name") @db.VarChar(100)
  motherName       String?  @map("mother_name") @db.VarChar(100)
  fatherPhone      String   @map("father_phone") @db.VarChar(20)
  motherPhone      String?  @map("mother_phone") @db.VarChar(20)
  fatherOccupation String?  @map("father_occupation") @db.VarChar(100)
  motherOccupation String?  @map("mother_occupation") @db.VarChar(100)
  emergencyContact String?  @map("emergency_contact") @db.VarChar(20)
  address          Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user             User     @relation(fields: [userId], references: [id])
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  studentMappings  StudentParentMap[]

  @@index([tenantId])
  @@map("parents")
}

model StudentParentMap {
  id           String             @id @default(uuid()) @db.Uuid
  studentId    String             @map("student_id") @db.Uuid
  parentId     String             @map("parent_id") @db.Uuid
  relationship ParentRelationship
  isPrimary    Boolean            @default(false) @map("is_primary")
  createdAt    DateTime           @default(now()) @map("created_at")

  // Relations
  student      Student            @relation(fields: [studentId], references: [id])
  parent       Parent             @relation(fields: [parentId], references: [id])

  @@unique([studentId, parentId])
  @@index([parentId])
  @@map("student_parent_map")
}

enum ParentRelationship {
  FATHER
  MOTHER
  GUARDIAN
}

// ============================================================
// FACULTY
// ============================================================

model Faculty {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.VarChar(50)
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  specialization String[] @default([])
  qualification  String?  @db.VarChar(255)
  joiningDate    DateTime @map("joining_date") @db.Date
  salary         Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  user           User     @relation(fields: [userId], references: [id])
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  classBatches   Batch[]  @relation("ClassTeacher")
  batchSubjects  BatchSubject[]

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("faculty")
}

// ============================================================
// BATCH & SUBJECT
// ============================================================

model Batch {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  name           String     @db.VarChar(255)
  code           String     @db.VarChar(50)
  targetExam     TargetExam @map("target_exam")
  academicYear   String     @map("academic_year") @db.VarChar(20)
  startDate      DateTime   @map("start_date") @db.Date
  endDate        DateTime   @map("end_date") @db.Date
  maxStrength    Int        @default(50) @map("max_strength")
  timing         Json       @default("{}") // { days: [], startTime, endTime }
  classTeacherId String?    @map("class_teacher_id") @db.Uuid
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // Relations
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  classTeacher   Faculty?   @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students       BatchStudent[]
  subjects       BatchSubject[]
  attendanceSessions AttendanceSession[]
  tests          Test[]
  feeStructures  FeeStructure[]
  studyMaterials StudyMaterial[]

  // Phase 5
  materials      Material[]
  assignments    Assignment[]
  onlineTests    OnlineTest[]
  videoLectures  VideoLecture[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isActive])
  @@map("batches")
}

model Subject {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  name       String       @db.VarChar(100)
  code       String       @db.VarChar(20)
  targetExam TargetExam[] @map("target_exam")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  // Relations
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  batchSubjects BatchSubject[]
  attendanceSessions AttendanceSession[]
  studyMaterials StudyMaterial[]

  // Phase 5
  materials      Material[]
  assignments    Assignment[]
  questions      Question[]
  questionBanks  QuestionBank[]
  onlineTests    OnlineTest[]
  videoLectures  VideoLecture[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("subjects")
}

model BatchStudent {
  id             String             @id @default(uuid()) @db.Uuid
  batchId        String             @map("batch_id") @db.Uuid
  studentId      String             @map("student_id") @db.Uuid
  joinedAt       DateTime           @default(now()) @map("joined_at") @db.Date
  transferredFrom String?           @map("transferred_from") @db.Uuid
  status         BatchStudentStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at")

  // Relations
  batch          Batch              @relation(fields: [batchId], references: [id])
  student        Student            @relation(fields: [studentId], references: [id])

  @@unique([batchId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("batch_students")
}

enum BatchStudentStatus {
  ACTIVE
  TRANSFERRED
  COMPLETED
}

model BatchSubject {
  id        String   @id @default(uuid()) @db.Uuid
  batchId   String   @map("batch_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  facultyId String?  @map("faculty_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  batch     Batch    @relation(fields: [batchId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  @@unique([batchId, subjectId])
  @@map("batch_subjects")
}

// ============================================================
// ATTENDANCE
// ============================================================

model AttendanceSession {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  batchId     String               @map("batch_id") @db.Uuid
  subjectId   String?              @map("subject_id") @db.Uuid
  sessionDate DateTime             @map("session_date") @db.Date
  sessionType AttendanceSessionType @map("session_type")
  takenBy     String               @map("taken_by") @db.Uuid
  isFinalized Boolean              @default(false) @map("is_finalized")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  batch       Batch                @relation(fields: [batchId], references: [id])
  subject     Subject?             @relation(fields: [subjectId], references: [id])
  faculty     User                 @relation("AttendanceTakenBy", fields: [takenBy], references: [id])
  records     AttendanceRecord[]

  @@unique([batchId, sessionDate, sessionType, subjectId])
  @@index([tenantId])
  @@index([sessionDate])
  @@map("attendance_sessions")
}

enum AttendanceSessionType {
  MORNING
  AFTERNOON
  SUBJECT
}

model AttendanceRecord {
  id        String           @id @default(uuid()) @db.Uuid
  sessionId String           @map("session_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  status    AttendanceStatus
  remarks   String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

// ============================================================
// TEST & RANKING
// ============================================================

model Test {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  batchId         String     @map("batch_id") @db.Uuid
  name            String     @db.VarChar(255)
  testType        TestType   @map("test_type")
  testDate        DateTime   @map("test_date") @db.Date
  totalMarks      Decimal    @map("total_marks") @db.Decimal(6, 2)
  durationMinutes Int?       @map("duration_minutes")
  subjectIds      String[]   @map("subject_ids") @db.Uuid
  hasOmr          Boolean    @default(false) @map("has_omr")
  omrTemplateUrl  String?    @map("omr_template_url") @db.VarChar(500)
  status          TestStatus @default(DRAFT)
  createdBy       String     @map("created_by") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  batch           Batch      @relation(fields: [batchId], references: [id])
  creator         User       @relation("TestCreatedBy", fields: [createdBy], references: [id])
  marks           TestMarks[]
  rankings        TestRanking[]

  @@index([tenantId])
  @@index([batchId])
  @@index([testDate])
  @@index([status])
  @@map("tests")
}

enum TestType {
  WEEKLY
  MONTHLY
  MOCK
  SCHOLARSHIP
  INTERNAL
}

enum TestStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  PUBLISHED
}

model TestMarks {
  id            String   @id @default(uuid()) @db.Uuid
  testId        String   @map("test_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  marksObtained Decimal  @map("marks_obtained") @db.Decimal(6, 2)
  subjectMarks  Json     @default("{}") @map("subject_marks") // { "math": 45, "english": 38 }
  isAbsent      Boolean  @default(false) @map("is_absent")
  remarks       String?  @db.Text
  enteredBy     String   @map("entered_by") @db.Uuid
  enteredAt     DateTime @default(now()) @map("entered_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id])
  enteredByUser User     @relation("MarksEnteredBy", fields: [enteredBy], references: [id])

  @@unique([testId, studentId])
  @@index([studentId])
  @@map("test_marks")
}

model TestRanking {
  id          String   @id @default(uuid()) @db.Uuid
  testId      String   @map("test_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  batchRank   Int      @map("batch_rank")
  overallRank Int?     @map("overall_rank")
  percentile  Decimal? @db.Decimal(5, 2)
  grade       String?  @db.VarChar(10)
  computedAt  DateTime @default(now()) @map("computed_at")

  // Relations
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([testId, studentId])
  @@index([studentId])
  @@index([batchRank])
  @@map("test_rankings")
}

// ============================================================
// FEES (Phase 4 — Complete Fee Management)
// ============================================================

model FeeStructure {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  batchId         String?         @map("batch_id") @db.Uuid
  name            String          @db.VarChar(255)
  feeType         FeeType         @map("fee_type")
  amount          Decimal         @db.Decimal(10, 2)
  dueDay          Int?            @map("due_day") // Day of month (1-28)
  isActive        Boolean         @default(true) @map("is_active")
  // Phase 4 extensions
  course          String?         @db.VarChar(255)
  academicYear    String          @default("2026-27") @map("academic_year") @db.VarChar(20)
  description     String?         @db.Text
  registrationFee Decimal         @default(0) @map("registration_fee") @db.Decimal(10, 2)
  admissionFee    Decimal         @default(0) @map("admission_fee") @db.Decimal(10, 2)
  monthlyFee      Decimal         @default(0) @map("monthly_fee") @db.Decimal(10, 2)
  materialFee     Decimal         @default(0) @map("material_fee") @db.Decimal(10, 2)
  examFee         Decimal         @default(0) @map("exam_fee") @db.Decimal(10, 2)
  totalFee        Decimal         @default(0) @map("total_fee") @db.Decimal(10, 2)
  installmentType InstallmentType @default(ONE_TIME) @map("installment_type")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  batch       Batch?       @relation(fields: [batchId], references: [id])
  invoices    FeeInvoice[]
  studentFees StudentFee[]

  @@index([tenantId])
  @@index([academicYear])
  @@map("fee_structures")
}

enum FeeType {
  ADMISSION
  MONTHLY
  QUARTERLY
  ANNUAL
  EXAM
  MATERIAL
  REGISTRATION
}

enum InstallmentType {
  ONE_TIME
  MONTHLY
  QUARTERLY
  CUSTOM
}

model FeeInvoice {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  feeStructureId  String        @map("fee_structure_id") @db.Uuid
  invoiceNumber   String        @unique @map("invoice_number") @db.VarChar(50)
  amount          Decimal       @db.Decimal(10, 2)
  dueDate         DateTime      @map("due_date") @db.Date
  status          InvoiceStatus @default(PENDING)
  month           Int?
  year            Int?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])
  feeStructure    FeeStructure  @relation(fields: [feeStructureId], references: [id])
  payments        FeePayment[]

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@map("fee_invoices")
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

model FeePayment {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  invoiceId         String?      @map("invoice_id") @db.Uuid
  studentFeeId      String?      @map("student_fee_id") @db.Uuid
  installmentId     String?      @map("installment_id") @db.Uuid
  amountPaid        Decimal      @map("amount_paid") @db.Decimal(10, 2)
  paymentDate       DateTime     @default(now()) @map("payment_date") @db.Date
  paymentMode       PaymentMode  @map("payment_mode")
  transactionId     String?      @map("transaction_id") @db.VarChar(100)
  razorpayOrderId   String?      @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?      @map("razorpay_payment_id") @db.VarChar(100)
  receiptNumber     String       @unique @map("receipt_number") @db.VarChar(50)
  collectedBy       String       @map("collected_by") @db.Uuid
  notes             String?      @db.Text
  isAdvance         Boolean      @default(false) @map("is_advance")
  adjustedAmount    Decimal?     @map("adjusted_amount") @db.Decimal(10, 2)
  createdAt         DateTime     @default(now()) @map("created_at")
  deletedAt         DateTime?    @map("deleted_at")

  // Relations
  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  invoice           FeeInvoice?  @relation(fields: [invoiceId], references: [id])
  studentFee        StudentFee?  @relation(fields: [studentFeeId], references: [id])
  installment       FeeInstallment? @relation(fields: [installmentId], references: [id])
  collector         User         @relation("PaymentCollectedBy", fields: [collectedBy], references: [id])
  receipt           FeeReceipt?

  @@index([tenantId])
  @@index([invoiceId])
  @@index([studentFeeId])
  @@index([installmentId])
  @@index([paymentDate])
  @@index([deletedAt])
  @@map("fee_payments")
}

enum PaymentMode {
  CASH
  RAZORPAY
  BANK_TRANSFER
  CHEQUE
  UPI
  CARD
}

// ============================================================
// STUDENT FEE ASSIGNMENT (Phase 4)
// ============================================================

model StudentFee {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  studentId       String          @map("student_id") @db.Uuid
  feeStructureId  String          @map("fee_structure_id") @db.Uuid
  academicYear    String          @map("academic_year") @db.VarChar(20)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(10, 2)
  discountAmount  Decimal         @default(0) @map("discount_amount") @db.Decimal(10, 2)
  netAmount       Decimal         @map("net_amount") @db.Decimal(10, 2)
  paidAmount      Decimal         @default(0) @map("paid_amount") @db.Decimal(10, 2)
  status          StudentFeeStatus @default(PENDING)
  assignedAt      DateTime        @default(now()) @map("assigned_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  // Relations
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id])
  feeStructure    FeeStructure    @relation(fields: [feeStructureId], references: [id])
  installments    FeeInstallment[]
  payments        FeePayment[]
  discounts       FeeDiscount[]
  refunds         FeeRefund[]

  @@unique([studentId, feeStructureId, academicYear])
  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([deletedAt])
  @@map("student_fees")
}

enum StudentFeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

// ============================================================
// FEE INSTALLMENTS (Phase 4)
// ============================================================

model FeeInstallment {
  id            String        @id @default(uuid()) @db.Uuid
  studentFeeId  String        @map("student_fee_id") @db.Uuid
  installmentNo Int           @map("installment_no")
  label         String        @db.VarChar(100) // "Jan 2026", "Q1 2026", etc.
  amount        Decimal       @db.Decimal(10, 2)
  dueDate       DateTime      @map("due_date") @db.Date
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  status        InvoiceStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  studentFee    StudentFee    @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  payments      FeePayment[]

  @@index([studentFeeId])
  @@index([dueDate])
  @@index([status])
  @@map("fee_installments")
}

// ============================================================
// FEE DISCOUNTS / SCHOLARSHIPS (Phase 4)
// ============================================================

model FeeDiscount {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  studentFeeId  String       @map("student_fee_id") @db.Uuid
  discountType  DiscountType @map("discount_type")
  discountMode  DiscountMode @map("discount_mode")
