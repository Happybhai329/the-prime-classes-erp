model OrganizationUnit {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  parentId       String?              @map("parent_id") @db.Uuid
  branchId       String?              @unique @map("branch_id") @db.Uuid
  tenantId       String?              @map("tenant_id") @db.Uuid
  type           OrganizationUnitType
  name           String               @db.VarChar(255)
  code           String               @db.VarChar(80)
  slug           String               @db.VarChar(120)
  address        Json                 @default("{}")
  geo            Json                 @default("{}")
  metadata       Json                 @default("{}")
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         OrganizationUnit?     @relation("OrganizationUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       OrganizationUnit[]    @relation("OrganizationUnitTree")
