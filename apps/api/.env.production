# ============================================================
# Prime ERP — API Production Environment Configuration
# ============================================================

# ---- Application ----
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=https://app.primeclasses.in,https://admin.primeclasses.in

# ---- Database ----
DATABASE_URL=postgresql://prime_prod_admin:production_secure_db_password@prod-db-primary.primeclasses.internal:5432/prime_prod?schema=public

# ---- Redis ----
REDIS_HOST=prod-redis-primary.primeclasses.internal
REDIS_PORT=6379
REDIS_PASSWORD=production_secure_redis_password

# ---- JWT ----
# MUST BE UNIQUE SECURE KEYS GENERATED FOR PRODUCTION
JWT_ACCESS_SECRET=production_secure_jwt_access_secret_do_not_share_or_commit
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=production_secure_jwt_refresh_secret_do_not_share_or_commit
JWT_REFRESH_EXPIRY=7d

# ---- MinIO / S3 Storage ----
MINIO_ENDPOINT=s3.amazonaws.com
MINIO_PORT=443
MINIO_ACCESS_KEY=production_aws_s3_access_key
MINIO_SECRET_KEY=production_aws_s3_secret_key
MINIO_BUCKET=prime-prod-erp-files
MINIO_USE_SSL=true

# ---- Firebase ----
FIREBASE_PROJECT_ID=prime-prod-fcm
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@prime-prod-fcm.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPRODUCTION_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---- Razorpay (Production Live Keys) ----
RAZORPAY_KEY_ID=rzp_live_production123
RAZORPAY_KEY_SECRET=production_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=production_webhook_secret_here

# ---- Email (SMTP) ----
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=production_sendgrid_smtp_password
SMTP_FROM=noreply@primeclasses.in

# ---- Rate Limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=150

# ---- Observability & OpenTelemetry ----
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo.monitoring.svc.cluster.local:4318/v1/traces
GRAFANA_ADMIN_PASSWORD=production_secure_grafana_password
ENABLE_ENTERPRISE_SCHEDULES=true
