# ============================================================
# Prime ERP — Root Environment Configuration Template
# ============================================================

# ---- Application (API) ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ---- Application (Web Frontend) ----
VITE_API_URL=http://localhost:3000/api/v1

# ---- Database (PostgreSQL) ----
POSTGRES_USER=prime_admin
POSTGRES_PASSWORD=prime_dev_password_change_me
POSTGRES_DB=prime_erp
DATABASE_URL=postgresql://prime_admin:prime_dev_password_change_me@localhost:5432/prime_erp?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password_change_me
REDIS_MAXMEMORY=1gb

# ---- JWT ----
JWT_ACCESS_SECRET=prime-access-secret-change-in-production-2025
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=prime-refresh-secret-change-in-production-2025
JWT_REFRESH_EXPIRY=7d

# ---- MinIO (S3-compatible storage) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=prime_minio
MINIO_ROOT_PASSWORD=prime_minio_password_change_me
MINIO_BUCKET=prime-erp-files
MINIO_USE_SSL=false

# ---- Firebase Cloud Messaging (Push Notifications) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Razorpay (Payment Gateway) ----
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (Gmail SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@primeclasses.in

# ---- Rate Limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- Observability & OpenTelemetry ----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
GRAFANA_ADMIN_PASSWORD=prime-grafana
